<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <NoWarn>$(NoWarn);1591</NoWarn>
    
    <!-- Package metadata -->
    <Company>PanoramicData</Company>
    <Product>PanoramicData.IssueAssessment</Product>
    <Description>A high-performance, extensible .NET 10 library for schema-agnostic issue/ticket quality assessment.</Description>
    <Authors>PanoramicData</Authors>
    <RepositoryUrl>https://github.com/panoramicdata/PanoramicData.IssueAssessment</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <License>MIT</License>
    <PackageProjectUrl>https://github.com/panoramicdata/PanoramicData.IssueAssessment</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>assessment;quality;jira;github;issues;tickets;json</PackageTags>
    
    <!-- Version (will be set by release script) -->
    <Version>1.0.0</Version>
  </PropertyGroup>

  <!-- Versioning from environment or default -->
  <PropertyGroup Condition="'$(GITHUB_RUN_NUMBER)' != ''">
    <Version>1.0.$(GITHUB_RUN_NUMBER)</Version>
  </PropertyGroup>
</Project>
