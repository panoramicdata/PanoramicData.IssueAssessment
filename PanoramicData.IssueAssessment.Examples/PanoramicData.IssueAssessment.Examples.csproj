<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<NeutralResourcesLanguage>en</NeutralResourcesLanguage>
		<OutputType>Exe</OutputType>
		<IsPackable>false</IsPackable>
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
		<!-- CA1303: the examples print literal text to the console. -->
		<NoWarn>$(NoWarn);CA1303</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<None Include="Fixtures\*.json" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\PanoramicData.IssueAssessment\PanoramicData.IssueAssessment.csproj" />
	</ItemGroup>

</Project>
