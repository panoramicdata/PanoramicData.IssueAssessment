<?xml version="1.0" encoding="utf-8"?>
<!-- Microsoft.Testing.Extensions.CodeCoverage settings: measure the library only. -->
<Configuration>
	<CodeCoverage>
		<ModulePaths>
			<Include>
				<ModulePath>.*PanoramicData\.IssueAssessment\.dll$</ModulePath>
			</Include>
		</ModulePaths>
		<Sources>
			<Exclude>
				<Source>.*[\\/]obj[\\/].*</Source>
			</Exclude>
		</Sources>
		<Attributes>
			<Exclude>
				<Attribute>^System\.Diagnostics\.CodeAnalysis\.ExcludeFromCodeCoverageAttribute$</Attribute>
				<!-- Source generated at build time, such as [GeneratedRegex] implementations, is not ours to test. -->
				<Attribute>^System\.CodeDom\.Compiler\.GeneratedCodeAttribute$</Attribute>
			</Exclude>
		</Attributes>
	</CodeCoverage>
</Configuration>
